{
  "name": "ai-free-ide",
  "version": "0.1.0",
  "description": "A modern, fully offline IDE for Linux. No network. No AI. No telemetry.",
  "license": "MIT",
  "author": "AI-Free IDE contributors",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run typecheck && npm run test:unit && npm run check:offline",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:offline": "node scripts/check-offline.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9",
    "typescript-language-server": "^5.3.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver-protocol": "^3.18.3",
    "zustand": "^5.0.15"
  }
}
